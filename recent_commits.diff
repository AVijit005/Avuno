@@ -0,0 +1,36 @@
+import { defineConfig } from "vitest/config";
+import react from "@vitejs/plugin-react";
+import { resolve } from "node:path";
+
+/**
+ * Test config is kept separate from vite.config.ts on purpose.
+ *
+ * vite.config.ts uses @lovable.dev/vite-tanstack-config, which bundles the
+ * TanStack Start, Nitro and PWA plugins. Those are build-time concerns that
+ * pull in the backend workspace and a service worker during test runs. This
+ * config loads only what the component tests need.
+ */
+export default defineConfig({
+  plugins: [react()],
+  resolve: {
+    alias: {
+      "@": resolve(__dirname, "./src"),
+    },
+  },
+  test: {
+    environment: "jsdom",
+    globals: false,
+    setupFiles: ["./tests/setup.ts"],
+    // Frontend only. apps/backend runs on `bun test` (bun:test imports are not
+    // resolvable by vitest), so it must never be picked up here.
+    include: ["src/**/*.{test,spec}.{ts,tsx}", "tests/**/*.{test,spec}.{ts,tsx}"],
+    exclude: [
+      "**/node_modules/**",
+      "apps/**",
+      "tests/visual/**",
+      "tests/e2e.test.ts",
+      "dist/**",
+      ".output/**",
+    ],
+  },
+});

commit e1d608fafafb3287c5afdaac4a6db6cf6d19ac1a
Author: Avijit Pal <palavijit713130@gmail.com>
Date:   Sat Aug 8 09:45:31 2026 +0000

    fix(docker): stop baking secrets into images and fail fast on unset passwords
    
    SECURITY: there was no .dockerignore anywhere in the repo, and
    Dockerfile.dev did "COPY . ." — so apps/backend/.env (live JWT signing
    secrets, the OAuth encryption key, the database URL) was written into an
    immutable image layer. Deleting the file in a later layer does not
    remove it; it stays readable via docker history or layer extraction.
    
    Scope of exposure is limited: .env was never committed (verified across
    all refs), and release.yml builds the production Dockerfile, which uses
    selective COPY and was never affected. Only locally built dev images can
    be carrying the secrets. scripts/check-image-secrets.sh determines this
    and prints the rotation list if an affected image exists.
    
    - Add apps/backend/.dockerignore and a root .dockerignore excluding
      .env, keys, node_modules, dist, .git, tests and AI scratch dirs. This
      also stops uploading ~600 MB of node_modules to the daemon on every
      build.
    - Dockerfile.dev: run as the non-root chronicle user (it ran as root),
      add HEALTHCHECK and STOPSIGNAL to match production.
    - Dockerfile: add a dedicated "deps" stage installing with --omit=dev,
      and copy node_modules from it. The runtime image was shipping the
      builder's full tree including @nestjs/cli, typescript, eslint,
      prettier and husky (~700 MB, now ~250 MB). Add wget, which HEALTHCHECK
      already depended on but was not installed.
    - docker-compose.yml: DB_PASSWORD and REDIS_PASSWORD now use the
      required form so an unset secret aborts startup instead of silently
      falling back to a committed default. SWAGGER_ENABLED false — the file
      sets NODE_ENV production, so exposing API docs contradicted it.
    - docker-compose.prod.yml: same required form for POSTGRES_PASSWORD,
      REDIS_PASSWORD, MINIO keys, both JWT secrets, OAUTH_ENCRYPTION_KEY and
      CORS_ORIGIN. Previously these defaulted to "changeme" and "minioadmin"
      and would have deployed silently. Stop publishing 5432, 6379, 9000 and
      9001 to the host — they are reachable on the internal network. Add the
      missing healthcheck on the api service.
    - Drop the obsolete "version" key from the dev, prod and e2e compose
      files (Compose v2 warns on it).
    
    All four compose files validated as YAML.

