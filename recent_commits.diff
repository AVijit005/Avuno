--- /dev/null
+++ b/src/lib/api/fetch-concurrency.test.ts
@@ -0,0 +1,140 @@
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+
+class MemStore {
+  m = new Map<string, string>();
+  getItem(k: string) {
+    return this.m.get(k) ?? null;
+  }
+  setItem(k: string, v: string) {
+    this.m.set(k, v);
+  }
+  removeItem(k: string) {
+    this.m.delete(k);
+  }
+  clear() {
+    this.m.clear();
+  }
+}
+function j(b: unknown, s = 200) {
+  return new Response(JSON.stringify(b), {
+    status: s,
+    headers: { "content-type": "application/json" },
+  });
+}
+function ok<T>(d: T) {
+  return j({ data: d, requestId: "r", timestamp: "t" }, 200);
+}
+function jwt() {
+  const p = { exp: Math.floor(Date.now() / 1000) + 3600, sub: "u1" };
+  const b = Buffer.from(JSON.stringify(p))
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+  return `h.${b}.s`;
+}
+
+let mod: typeof import("./fetch");
+beforeEach(async () => {
+  vi.resetModules();
+  vi.stubGlobal("window", {
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => true,
+  });
+  vi.stubGlobal("sessionStorage", new MemStore());
+  vi.stubGlobal(
+    "CustomEvent",
+    class {
+      constructor(public type: string) {}
+    },
+  );
+  mod = await import("./fetch");
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+/**
+ * Behavioural traces for the auth/retry loop, written during review to prove
+ * the paths that are hard to reason about: concurrent refresh, abort
+ * propagation, and method-dependent 429 handling.
+ */
+describe("apiFetch adversarial traces", () => {
+  it("(g) concurrent 401s share ONE refresh", async () => {
+    mod.setAccessToken(jwt());
+    let refreshes = 0,
+      business = 0;
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async (u: RequestInfo | URL) => {
+        const url = String(u);
+        if (url.includes("/auth/refresh")) {
+          refreshes++;
+          await new Promise((r) => setTimeout(r, 10));
+          return ok({ accessToken: jwt(), expiresIn: 900 });
+        }
+        business++;
+        return business <= 5 ? j({ statusCode: 401, message: "x" }, 401) : ok({ id: business });
+      }),
+    );
+    await Promise.all([
+      mod.apiGet("/a"),
+      mod.apiGet("/b"),
+      mod.apiGet("/c"),
+      mod.apiGet("/d"),
+      mod.apiGet("/e"),
+    ]);
+    expect(refreshes).toBe(1);
+  });
+
+  it("(d) external abort propagates, not swallowed as timeout", async () => {
+    mod.setAccessToken(jwt());
+    const ac = new AbortController();
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async () => {
+        ac.abort();
+        throw Object.assign(new DOMException("aborted", "AbortError"));
+      }),
+    );
+    await expect(mod.apiGet("/x", { signal: ac.signal })).rejects.toMatchObject({
+      name: "AbortError",
+    });
+  });
+
+  it("(e) 429 on POST is not retried", async () => {
+    mod.setAccessToken(jwt());
+    const f = vi.fn(async () => j({ statusCode: 429, message: "slow down" }, 429));
+    vi.stubGlobal("fetch", f);
+    await expect(mod.apiPost("/x", {})).rejects.toMatchObject({ status: 429 });
+    expect(f).toHaveBeenCalledTimes(1);
+  });
+
+  it("(e2) 429 on GET IS retried", async () => {
+    mod.setAccessToken(jwt());
+    const f = vi.fn(async () => j({ statusCode: 429, message: "slow down" }, 429));
+    vi.stubGlobal("fetch", f);
+    await expect(mod.apiGet("/x")).rejects.toMatchObject({ status: 429 });
+    expect(f).toHaveBeenCalledTimes(3);
+  }, 20000);
+
+  it("never resolves undefined / never spins forever", async () => {
+    mod.setAccessToken(jwt());
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async () => ok({ v: 1 })),
+    );
+    await expect(mod.apiGet("/x")).resolves.toEqual({ v: 1 });
+  });
+
+  it("204 returns null without parsing", async () => {
+    mod.setAccessToken(jwt());
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async () => new Response(null, { status: 204 })),
+    );
+    await expect(mod.apiDelete("/x")).resolves.toBeNull();
+  });
+});

commit 60c232212acd5d592f8d3899d24d90321f9b776c
Author: Avijit Pal <palavijit713130@gmail.com>
Date:   Sun Aug 9 02:18:21 2026 +0000

    chore(backend): make the lint, format and typecheck gates pass
    
    Phase 0 turned the CI gates into real, failing-capable checks. Running
    them against the backend surfaced a large amount of pre-existing debt
    that the previous non-failing gates had hidden. This clears it so the
    gates can actually be enforced.
    
    Typecheck: 140 errors -> 0
    - @types/bun was never installed, so every `bun:test` import was
      unresolved (-52 errors).
    - roles.guard.spec.ts had no imports at all and relied on ambient
      globals; app.bootstrap.spec.ts and auth.module.spec.ts were written
      against Jest (jest.mock, jest.fn) which does not exist under the
      configured runner. All three are ported to bun:test — meaning
      app.bootstrap.spec and roles.guard.spec had never executed.
    - LibraryRow was missing `deletedAt`, despite five places in
      library.repository.ts reading it and every query filtering on it. A
      real type gap, not a test problem.
    - media.service.spec mocks declared the wrong repository contract:
      findMany resolves to MediaRow[], not { data, hasMore }.
    - Two more `login.refreshToken` assertions, same as the earlier batch:
      login has never returned the refresh token in its body.
    - Remaining implicit-any parameters annotated.
    
    Lint: 408 errors -> 0 (22 warnings)
    - The eslint config declared no test globals, so every spec reported
      describe/it/expect as no-undef — 59 phantom errors that buried the
      real findings. Added a spec-specific block; it must restate the parser
      because flat config replaces `languageOptions` wholesale rather than
      merging, which is a trap I hit while writing it.
    - Added the missing Node/Web globals (URL, TextDecoder, AbortController,
      performance, ...).
    - Removed 13 genuinely unused imports and 12 now-redundant
      eslint-disable directives.
    - Marked intentionally-unused parameters with the _ prefix rather than
      deleting them: they are required by decorator and public-API
      contracts.
    - image.service.ts: the \x00 in the filename sanitiser is deliberate (a
      NUL can truncate paths in downstream C APIs) and is now documented
      with a scoped disable rather than silenced globally. MAX_DIMENSION was
      declared and never enforced — kept and exported with a TODO, since
      quietly deleting it would remove the record that decompression-bomb
      protection is missing.
    - CI lint gate set to --max-warnings=22: zero errors is enforced, and
      the cap freezes the remaining no-explicit-any debt in the dynamic
      Prisma delegate pattern so it cannot grow before the typed refactor.
    
    Format: prettier applied to the 24 files that had never been formatted.
    
    Backend test suite: 471 -> 547 passing, 13 -> 0 failing. The three
    "module-loading race" failures I had attributed to @nestjs/testing were
    in fact these broken Jest-style specs; porting them resolved it.

