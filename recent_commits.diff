diff --git a/src/routes/auth.reset-password.tsx b/src/routes/auth.reset-password.tsx
new file mode 100644
index 0000000..24087a5
--- /dev/null
+++ b/src/routes/auth.reset-password.tsx
@@ -0,0 +1,133 @@
+import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
+import { AtmosphereBackground } from "@/components/atmosphere/AtmosphereBackground";
+import { LiquidGlassCard } from "@/components/auth/LiquidGlassCard";
+import { authApi } from "@/lib/api";
+import { useEffect, useState } from "react";
+import { toast } from "sonner";
+
+export const Route = createFileRoute("/auth/reset-password")({
+  component: ResetPasswordPage,
+});
+
+/** Mirrors the backend constraint so the user is told before submitting. */
+const MIN_PASSWORD_LENGTH = 12;
+
+function ResetPasswordPage() {
+  const navigate = useNavigate();
+  const [token, setToken] = useState<string | null>(null);
+  const [password, setPassword] = useState("");
+  const [confirm, setConfirm] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  useEffect(() => {
+    if (typeof window === "undefined") return;
+    const value = new URLSearchParams(window.location.search).get("token");
+    setToken(value);
+    // Scrub the token from the URL so it does not linger in history or leak
+    // via Referer to anything this page loads.
+    if (value) window.history.replaceState({}, "", "/auth/reset-password");
+  }, []);
+
+  const tooShort = password.length > 0 && password.length < MIN_PASSWORD_LENGTH;
+  const mismatch = confirm.length > 0 && password !== confirm;
+  const canSubmit =
+    !!token && password.length >= MIN_PASSWORD_LENGTH && password === confirm && !isSubmitting;
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!canSubmit || !token) return;
+
+    setIsSubmitting(true);
+    try {
+      await authApi.resetPassword({ token, password });
+      toast.success("Password updated", { description: "Please sign in with your new password." });
+      navigate({ to: "/auth" });
+    } catch (error) {
+      // The server returns one message for expired, already-used and unknown
+      // tokens, so nothing can be inferred from the failure.
+      toast.error(
+        error instanceof Error ? error.message : "This reset link is invalid or has expired.",
+      );
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  return (
+    <div className="relative flex min-h-screen items-center justify-center px-4">
+      <AtmosphereBackground intensity="soft" />
+      <LiquidGlassCard className="w-full max-w-md p-8">
+        <h1 className="font-display text-2xl tracking-tight text-white">Choose a new password</h1>
+
+        {!token ? (
+          <>
+            <p className="mt-3 text-sm text-white/70">
+              This link is missing its token. Request a new one and try again.
+            </p>
+            <Link
+              to="/auth/forgot-password"
+              className="mt-6 inline-block text-sm text-white/70 underline underline-offset-4 hover:text-white"
+            >
+              Request a new link
+            </Link>
+          </>
+        ) : (
+          <form onSubmit={handleSubmit} className="mt-6 space-y-4">
+            <div>
+              <label htmlFor="new-password" className="sr-only">
+                New password
+              </label>
+              <input
+                id="new-password"
+                type="password"
+                autoComplete="new-password"
+                required
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                placeholder="New password"
+                className="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white outline-none placeholder:text-white/45 focus:border-white/25"
+              />
+              <p className="mt-1 text-xs text-white/60">
+                At least {MIN_PASSWORD_LENGTH} characters.
+              </p>
+            </div>
+
+            <div>
+              <label htmlFor="confirm-password" className="sr-only">
+                Confirm new password
+              </label>
+              <input
+                id="confirm-password"
+                type="password"
+                autoComplete="new-password"
+                required
+                value={confirm}
+                onChange={(e) => setConfirm(e.target.value)}
+                placeholder="Confirm new password"
+                className="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white outline-none placeholder:text-white/45 focus:border-white/25"
+              />
+              {tooShort && (
+                <p className="mt-1 text-xs text-white/70">
+                  Use at least {MIN_PASSWORD_LENGTH} characters.
+                </p>
+              )}
+              {mismatch && <p className="mt-1 text-xs text-white/70">Passwords do not match.</p>}
+            </div>
+
+            <button
+              type="submit"
+              disabled={!canSubmit}
+              className="w-full rounded-full bg-white px-4 py-3 text-sm font-medium text-black transition disabled:opacity-40"
+            >
+              {isSubmitting ? "Updating…" : "Update password"}
+            </button>
+          </form>
+        )}
+
+        <p className="mt-6 text-xs text-white/60">
+          Resetting your password signs you out everywhere else.
+        </p>
+      </LiquidGlassCard>
+    </div>
+  );
+}

commit f3129ca8aa6bb8895a3235c2a031c18968576837
Author: Avijit Pal <palavijit713130@gmail.com>
Date:   Sun Aug 9 05:47:15 2026 +0000

    fix(data): repair the migration baseline, cursor pagination, and backups
    
    Five data-integrity defects. Each was silent: nothing failed loudly, so
    none of them appeared in logs or tests.
    
    1. CRITICAL — the migration baseline was a 0-byte file
       prisma/migrations/0_init/migration.sql was empty, so no migration in
       the history ever created a table. Every later migration ALTERed
       objects nothing had defined, which means `prisma migrate deploy`
       against a fresh database failed on the second migration. There was no
       reproducible path from empty to current schema and therefore no
       viable disaster recovery — restoring a dump into a new database could
       not have worked.
    
       Regenerated from the datamodel (65 tables, 24 enums, 503 indexes).
       Because it reflects the current schema it already contains the end
       state of the later migrations, so those are now idempotent
       (ADD COLUMN IF NOT EXISTS / DROP ... IF EXISTS) and are harmless
       no-ops on a fresh database while still applying to an existing one.
       Verified by simulating the full chain from empty: 0 conflicts.
    
       This surfaced real schema drift: schema.prisma declared
       onDelete: SetNull on the eight CollectionItem media relations while
       the applied migration set RESTRICT. SetNull is also wrong on its own
       terms — it would leave CollectionItem rows with all eight media FKs
       null, which resolveMediaType renders as "Unknown" ghost entries.
       Aligned the schema to RESTRICT.
    
    2. HIGH — cursor pagination silently dropped a record per page
       buildCursorMeta encoded items[limit], the first row of the NEXT page,
       while every repository pairs the cursor with Prisma `skip: 1`. That
       row was then skipped. Walking 10 rows at a page size of 3 returned 8;
       roughly 5-20% of every list was unreachable depending on page size.
       The cursor is now the last row of the current page.
    
    3. HIGH — frontend and backend disagreed on the pagination envelope
       The backend returns { items, hasMore, cursor } from the journal,
       memory, timeline, quote, highlight and interaction endpoints. The
       frontend declared { items|data, hasMore, nextCursor }, so
       getNextPageParam always read undefined and pagination stopped after
       page one, and PersonalMemory.tsx read `.data` off a page that has
       `items` — producing [undefined] and crashing on every media detail
       page. TypeScript could not catch it because the declared type was
       simply wrong.
    
       Added src/lib/api/pagination.ts with the two envelopes the backend
       actually uses (both are legitimate: library/media use an id cursor via
       buildCursorMeta, journal/interaction a timestamp cursor via a `lt`
       filter) plus a nextPageParam helper that stops on hasMore — these
       endpoints emit a cursor even on the final page, so trusting it alone
       loops forever. Also fixed listWrapped, which read `.items` off an
       endpoint that returns a bare array.
    
    4. HIGH — multi-write deletes were not atomic
       deleteMemory and deleteWrappedYear each wrote to two tables with no
       transaction and verified ownership in a separate read. A failure
       between the writes left orphaned child rows.
    
       Both are now single transactions with ownership folded into the delete
       predicate. Ownership is checked BEFORE the child delete: the array
       form of $transaction commits a zero-row delete rather than erroring,
       so verifying afterwards would have destroyed a victim's stats while
       their parent row survived — a destructive IDOR. I wrote that version
       first; the tests here exist because of it, and they fail against it.
    
       upsertStats replaced its deleteMany-then-N-creates loop with a single
       transaction and createMany; a crash mid-loop previously left a
       WrappedYear with zero stats and no recovery short of regenerating.
    
    5. CRITICAL — there were no backups
       BackupService had zero call sites, no @Cron anywhere, and no
       controller. docs/BACKUP.md documented a daily schedule and a
       POST /api/deployment/backup/database endpoint; neither existed. RPO
       was infinite.
    
       Replaced with scripts/backup.sh and scripts/restore.sh, run by a
       sidecar in docker-compose.prod.yml. Outside the API process
       deliberately: the in-app version would have died with the app, blocked
       the event loop for the entire dump (execSync), and run once per
       replica.
    
       - age encryption via BACKUP_AGE_RECIPIENT. Warns loudly when unset —
         a plaintext dump contains every user record.
       - Offsite upload via BACKUP_S3_URI. A backup that lives only on the
         machine it backs up is not a backup.
       - pg_dump --format=custom so pg_restore can restore selectively.
       - Writes to a .partial file and rejects dumps under 1KB, so a
         truncated stream cannot masquerade as a good backup.
       - restore.sh requires an explicit target URL (never DATABASE_URL) and
         refuses anything matching /prod/ without an explicit override.
       - `restore.sh --drill` restores into a scratch database and fails if
         fewer than 10 tables appear — the failure nobody checks is a restore
         that "succeeds" into an empty schema.
    
       Deleted BackupService and RestoreService rather than leaving dead code
       that documents capabilities we do not have, and rewrote docs/BACKUP.md
       to describe what actually runs.
    
    CI now guards all three: the baseline must be non-empty and create
    tables, the backup scripts must exist and parse, and the compose stack
    must schedule them.
    
    Tests: 20 new cases (cursor traversal at seven page-size combinations,
    transactional delete ownership, pagination envelope termination). Backend
    573 passing, frontend 33. All gates green on both workspaces.

