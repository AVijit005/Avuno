# syntax=docker/dockerfile:1
# Chronicle Backend — Development Dockerfile with hot reload
#
# NOTE: `COPY . .` below relies on .dockerignore to exclude .env. Do not
# remove or bypass that file: without it, live JWT signing secrets and the
# OAuth encryption key are baked into an image layer permanently.

FROM node:22-alpine

WORKDIR /app

# Build toolchain for native modules (argon2 et al).
RUN apk add --no-cache python3 make g++ wget

# Run as a non-root user, matching the production image. Created before the
# dependency install so the resulting tree is owned correctly.
RUN addgroup --system --gid 1001 chronicle && \
    adduser --system --uid 1001 chronicle

COPY --chown=chronicle:chronicle package.json ./
RUN npm install

COPY --chown=chronicle:chronicle prisma ./prisma
RUN npx prisma generate

COPY --chown=chronicle:chronicle . .

# prisma generate writes into node_modules; re-assert ownership so the
# unprivileged user can read the generated client.
RUN chown -R chronicle:chronicle /app/node_modules

USER chronicle

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

STOPSIGNAL SIGTERM

CMD ["npm", "run", "start:dev"]
