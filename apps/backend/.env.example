# Chronicle Backend — Production Environment Template
# Copy to .env and fill in real values

# Database URL with connection pooling optimized for production (e.g. pgBouncer or Prisma pooling)
DATABASE_URL="postgresql://user:password@host:5432/chronicle?schema=public&connection_limit=5&pool_timeout=10"
PORT=3000

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# Generate with: openssl rand -hex 32 (must be exactly 32 hex chars)
OAUTH_ENCRYPTION_KEY=

# OAuth (if using Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://YOURDOMAIN/api/auth/google/callback

# Observability / Error Tracking
SENTRY_DSN=

NODE_ENV=production
API_PREFIX=api

# Redis (required — shared across all app instances)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=chronicle

# Optional features
SWAGGER_ENABLED=false

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://YOURDOMAIN

# Email verification (requires Resend API key)
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_API_KEY=
EMAIL_VERIFICATION_SUCCESS_URL=https://YOURDOMAIN/auth/email-verified
EMAIL_VERIFICATION_FAILURE_URL=https://YOURDOMAIN/auth/email-verification-failed
APP_BASE_URL=https://YOURDOMAIN/api

# Sessions (stored in PostgreSQL, rate limiting in Redis)
SESSION_TTL_SECONDS=604800
COOKIE_DOMAIN=

# Storage (optional — uses local fs by default)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
